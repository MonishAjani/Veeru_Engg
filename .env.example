# API URL - URL of the Django backend API
NEXT_PUBLIC_API_URL=https://api.veeruengineering.com/api

# Environment - 'development' or 'production'
NODE_ENV=production

# Analytics (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Deployment URL - Used for canonical URLs and sitemap
NEXT_PUBLIC_DEPLOYMENT_URL=https://veeruengineering.com

# Image optimization settings
NEXT_PUBLIC_IMAGE_DOMAINS=api.veeruengineering.com,veeruengineering.com,localhost

# Feature flags (optional)
NEXT_PUBLIC_ENABLE_BLOG=false
NEXT_PUBLIC_ENABLE_TESTIMONIALS=true