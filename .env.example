# API URL - URL of the Django backend API
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# Domain configuration
NEXT_PUBLIC_DOMAIN=yourdomain.com
NEXT_PUBLIC_API_DOMAIN=api.yourdomain.com

# Environment - 'development' or 'production'
NODE_ENV=production

# Analytics (optional)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Deployment URL - Used for canonical URLs and sitemap
NEXT_PUBLIC_DEPLOYMENT_URL=https://yourdomain.com

# Image optimization settings
NEXT_PUBLIC_IMAGE_DOMAINS=api.yourdomain.com,yourdomain.com,localhost

# Feature flags (optional)
NEXT_PUBLIC_ENABLE_BLOG=false
NEXT_PUBLIC_ENABLE_TESTIMONIALS=true