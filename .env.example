# Frontend Environment Variables

# API Base URL - Update this to your Render backend URL
NEXT_PUBLIC_API_BASE=https://veeru-engineering-api.onrender.com/api

# Set to 'true' to use mock data even in production (for testing)
NEXT_PUBLIC_USE_MOCK_DATA=false

# Other environment variables
NEXT_PUBLIC_SITE_URL=https://veeruengineering.com