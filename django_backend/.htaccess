<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^(.*)$ passenger_wsgi.py/$1 [QSA,L]
</IfModule>

# Serve static files directly
<IfModule mod_alias.c>
    Alias /static/ /home/username/yourdomain.com/backend/staticfiles/
    Alias /media/ /home/username/yourdomain.com/backend/media/
</IfModule>

<Directory /home/username/yourdomain.com/backend/staticfiles>
    Require all granted
</Directory>

<Directory /home/username/yourdomain.com/backend/media>
    Require all granted
</Directory>