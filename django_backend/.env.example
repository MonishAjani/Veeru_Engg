# Django settings
SECRET_KEY=your_secret_key_here
DJANGO_ENV=production  # Set to 'production' in production, 'development' in development
DJANGO_SETTINGS_MODULE=django_backend.settings_prod  # Use settings_prod.py in production

# Database settings
DB_NAME=infracorp
DB_USER=infracorpuser
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Email settings
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=noreply@veeruengineering.com

# Cloudinary settings (if using Cloudinary for media storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Security settings
ALLOWED_HOSTS=api.veeruengineering.com,veeruengineering.com,www.veeruengineering.com
CORS_ALLOWED_ORIGINS=https://veeruengineering.com,https://www.veeruengineering.com

# Sentry settings (for error tracking)
SENTRY_DSN=your_sentry_dsn

# Redis settings (for caching)
REDIS_URL=redis://localhost:6379/1